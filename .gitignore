# ─── Frontend ───────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/.env*.local
frontend/coverage/

# ─── Backend ────────────────────────────────────────────────────────────────
# Artefato intermediário do generate_openapi.py — só o TS gerado a partir
# dele (frontend/lib/api-types.generated.ts) é versionado.
backend/openapi.json
backend/__pycache__/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
backend/.env
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/dist/
backend/build/

# ─── Ambiente ────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ─── Segredos de produção ───────────────────────────────────────────────────
# Token da Cloudflare usado pelo certbot (DNS-01) — gerado pelo deploy.sh
nginx/cloudflare.ini

# ─── Tokens/credenciais da integração Ailos (NUNCA versionar) ────────────────
backend/scripts/ailos_cooperado_jwt.json
backend/scripts/ailos_login_gerado.json

# ─── Certificado digital ICP-Brasil / e-CNPJ (chave privada — NUNCA versionar) ──
*.pfx
*.p12
*.PFX
*.P12
*.pem
*.key

# ─── XMLs de NFS-e gerados pelo script de teste ──────────────────────────────
backend/scripts/nfse_saida/
backend/certs/

# ─── Artefatos gerados em testes (não versionar) ─────────────────────────────
backend/nfse_rps_teste.xml
backend/scripts/nfse_rps_teste.xml
backend/teste_logo_barcode.pdf
backend/scripts/tst.py

# ─── Manuais/PDFs de referência (pesados — manter fora do git) ───────────────
*.pdf
# Duplicatas de docs em backend/scripts (versiona-se só as cópias da raiz)
backend/scripts/*.postman_collection.json

# ─── IDEs e SO ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
