# =============================================================================
# .env.example — copie para .env e ajuste os valores
#
# PRODUÇÃO: nunca use os valores abaixo como estão.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_DB=rastreamento
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
DATABASE_URL=postgresql+psycopg://postgres:TROQUE_POR_SENHA_FORTE_AQUI@db:5432/rastreamento

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Armazenamento (MinIO) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=TROQUE_USUARIO_MINIO
MINIO_ROOT_PASSWORD=TROQUE_SENHA_MINIO_MIN_8_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=rastreamento
# Em produção com HTTPS: https://storage.seudominio.com.br
MINIO_PUBLIC_URL=http://localhost:9000

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO: gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# PRODUÇÃO: sempre false — expõe token de reset no response apenas em dev
DEBUG_RETURN_RESET_TOKEN=false

# ── URLs públicas ─────────────────────────────────────────────────────────────
# Desenvolvimento
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# BACKEND_PUBLIC_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# Produção (substitua pelo seu domínio)
NEXT_PUBLIC_API_URL=https://api.seudominio.com.br/api/v1
BACKEND_PUBLIC_URL=https://api.seudominio.com.br
FRONTEND_URL=https://seudominio.com.br

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Limites padrão (requisições por janela de tempo)
RATE_LIMIT_DEFAULT=200/minute        # geral por IP
RATE_LIMIT_LOGIN=5/minute            # anti-brute-force no login
RATE_LIMIT_EXPORTS=10/minute         # exportações pesadas

# ── Integração Multiportal ────────────────────────────────────────────────────
MULTIPORTAL_ENABLED=false
MULTIPORTAL_WSDL_URL=http://ws1.1gps.com.br:80/services/IntegracaoAdmService?wsdl
MULTIPORTAL_ID=
MULTIPORTAL_PASSWORD=
MULTIPORTAL_GROUP_CODES=
MULTIPORTAL_SEND_WELCOME_EMAIL=false
MULTIPORTAL_REQUEST_TIMEOUT=30

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=30
# Webhook Discord/Slack para alertas de falha (opcional)
# ALERT_WEBHOOK=https://discord.com/api/webhooks/...
# Destino rclone (Backblaze B2, S3, Google Drive, etc.)
# RCLONE_REMOTE=b2:mastersat-backups
