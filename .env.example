# =============================================================================
# .env.example — copie para .env e ajuste os valores
#
# PRODUÇÃO: nunca use os valores abaixo como estão.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_DB=rastreamento
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
DATABASE_URL=postgresql+psycopg://postgres:TROQUE_POR_SENHA_FORTE_AQUI@db:5432/rastreamento

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Armazenamento (MinIO) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=TROQUE_USUARIO_MINIO
MINIO_ROOT_PASSWORD=TROQUE_SENHA_MINIO_MIN_8_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=rastreamento
# MinIO nunca fica exposto publicamente (sem subdomínio próprio): downloads
# de documentos passam pelo backend (proxy), então este valor não é usado
# em produção. Mantenha localhost.
MINIO_PUBLIC_URL=http://localhost:9000

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO: gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# PRODUÇÃO: sempre false — expõe token de reset no response apenas em dev
DEBUG_RETURN_RESET_TOKEN=false

# ── Integração externa (CobraZap etc.) ────────────────────────────────────────
# Chave de serviço para o parceiro puxar os boletos em GET /api/v1/integrations/cobrancas
# (header X-API-Key). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio = endpoint desativado (503).
INTEGRATION_API_KEY=

# ── URLs públicas ─────────────────────────────────────────────────────────────
# Desenvolvimento
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# BACKEND_PUBLIC_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# Produção — arquitetura por subdomínio (substitua pelo seu domínio)
NEXT_PUBLIC_API_URL=https://api.seudominio.com.br/api/v1
BACKEND_PUBLIC_URL=https://api.seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br

# ── Cloudflare (OPCIONAL — só para deploy ATRÁS da Cloudflare via DNS-01) ──────
# O deploy.sh padrão usa Let's Encrypt HTTP-01 (porta 80) e NÃO precisa deste
# token. Só preencha se for emitir o certificado via DNS-01 na Cloudflare
# (token "Zone:DNS:Edit" da zona, criado em dash.cloudflare.com/profile/api-tokens).
CLOUDFLARE_API_TOKEN=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Limites padrão (requisições por janela de tempo)
RATE_LIMIT_DEFAULT=200/minute        # geral por IP
RATE_LIMIT_LOGIN=5/minute            # anti-brute-force no login
RATE_LIMIT_EXPORTS=10/minute         # exportações pesadas

# ── Integração Multiportal ────────────────────────────────────────────────────
MULTIPORTAL_ENABLED=false
MULTIPORTAL_WSDL_URL=http://ws1.1gps.com.br:80/services/IntegracaoAdmService?wsdl
MULTIPORTAL_ID=
MULTIPORTAL_PASSWORD=
MULTIPORTAL_GROUP_CODES=
MULTIPORTAL_SEND_WELCOME_EMAIL=false
MULTIPORTAL_REQUEST_TIMEOUT=30

# ── Integração Ailos (Cobrança Bancária API) ──────────────────────────────────
# Integração singleton (1 convênio/cooperado) com a API REST de Cobrança Ailos.
# Sem estas credenciais preenchidas, as rotas /api/v1/ailos/* (exceto /status)
# retornam 400 e o fluxo CNAB existente (boletos.py) continua funcionando normal.
#
# AILOS_ENV: 'sandbox' ou 'production'
AILOS_ENV=sandbox
# URLs fornecidas pela Ailos no onboarding (APIM/WSO2 e Gateway)
AILOS_APIM_BASE_URL=
AILOS_GATEWAY_BASE_URL=
# Credenciais do app (consumer key/secret) cadastradas no portal Ailos
AILOS_CLIENT_ID=
AILOS_CLIENT_SECRET=
AILOS_DEVELOPER_KEY=
# URL pública que recebe o callback OAuth2 do cooperado (deve apontar para
# {BACKEND_PUBLIC_URL}/api/v1/ailos/callback e estar acessível pela Ailos)
AILOS_CALLBACK_URL=https://api.seudominio.com.br/api/v1/ailos/callback
AILOS_TIMEOUT_SECONDS=30
# Convênio/carteira — mesmo convênio usado pelo CNAB (boleto_ailos.py)
AILOS_NUMERO_CONVENIO=102004
AILOS_DEFAULT_CARTEIRA=1
AILOS_DEFAULT_FORMA_EMISSAO=2
# 1 = boleto REGISTRADO na Nuclea (valor do Postman oficial Ailos). Não use 2.
AILOS_DEFAULT_INDICADOR_REGISTRO_NUCLEA=1
# BolePix (boleto híbrido com QR Code Pix). Só funciona se a conta tiver uma
# chave Pix ALEATÓRIA cadastrada, ativada e vinculada à funcionalidade na Ailos.
AILOS_BOLE_PIX=false
# Re-login automático headless: mantém a sessão do cooperado viva 24/7 sem
# reautorizar no navegador. ⚠ 3 SENHAS ERRADAS BLOQUEIAM A CONTA — só ligue
# com a senha CONFIRMADA (teste antes com scripts/ailos_login_direto.py). O
# sistema trava em 2 tentativas falhas para nunca chegar nas 3.
AILOS_AUTO_RELOGIN=false
AILOS_COOPERADO_COOPERATIVA=
AILOS_COOPERADO_CONTA=
AILOS_COOPERADO_SENHA=
# Chave Fernet para criptografar tokens salvos no banco. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AILOS_TOKEN_ENCRYPTION_KEY=

# ── NFS-e Joinville (Pública / Nota Nacional) ─────────────────────────────────
# Emissão comprovada SEM certificado (homologação aceita RPS sem assinatura).
# Os defaults da MasterSat já estão no código; aqui é só para sobrescrever.
NFSE_ENABLED=true
# 'homologacao' (testes) ou 'producao' (notas com valor legal!)
NFSE_ENV=homologacao
NFSE_CNPJ=14228344000167
NFSE_INSCRICAO_MUNICIPAL=109545
# Natureza autorizada do prestador no cadastro da prefeitura
NFSE_NATUREZA_OPERACAO=107
NFSE_ITEM_LISTA_SERVICO=1102
NFSE_ALIQUOTA_ISS=2.00
NFSE_CODIGO_MUNICIPIO=4209102
# Série do RPS — Joinville exige 3000 no WebService (série errada = erro E97)
NFSE_SERIE_RPS=3000
NFSE_OPTANTE_SIMPLES=1
NFSE_INCENTIVADOR_CULTURAL=2
NFSE_ISS_RETIDO=2
# Certificado A1 OPCIONAL (.pfx) — se vazio, envia sem assinatura (funciona)
NFSE_CERT_PATH=
NFSE_CERT_SENHA=
NFSE_TIMEOUT_SECONDS=60

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=30
# Webhook Discord/Slack para alertas (opcional): falha de backup E queda da
# sessão do cooperado Ailos (emissão de boletos parada — alerta na hora)
# ALERT_WEBHOOK=https://discord.com/api/webhooks/...
# Destino rclone (Backblaze B2, S3, Google Drive, etc.)
# RCLONE_REMOTE=b2:mastersat-backups
