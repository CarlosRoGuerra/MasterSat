# Copie para backup/backup.env (ignorado pelo git) e preencha.
# Este arquivo é entregue SÓ ao container de backup (serviço pg_dump).
# Não coloque aqui AILOS_TOKEN_ENCRYPTION_KEY nem outros segredos da aplicação.

# ── Destino externo (obrigatório para o backup terminar OK) ──────────────────
# Remoto rclone configurado por variáveis RCLONE_CONFIG_<NOME>_*.
# Recomendado: um remoto "crypt" por cima do bucket, para os objetos (PDFs de
# contratos, documentos de clientes) saírem cifrados do servidor.
RCLONE_REMOTE=offsite:
# Exemplo Backblaze B2 + crypt:
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=<keyID>
# RCLONE_CONFIG_B2_KEY=<applicationKey>
# RCLONE_CONFIG_OFFSITE_TYPE=crypt
# RCLONE_CONFIG_OFFSITE_REMOTE=b2:mastersat-backups
# RCLONE_CONFIG_OFFSITE_PASSWORD=<saída de: rclone obscure 'senha-longa'>
# RCLONE_CONFIG_OFFSITE_PASSWORD2=<saída de: rclone obscure 'outro-sal'>
# A senha do crypt (antes do obscure) vai para o COFRE junto com a chave Fernet:
# sem ela, o que está no destino externo é ilegível.

# Retenção no destino externo (dias; as 7 execuções mais novas nunca saem)
BACKUP_REMOTE_KEEP_DAYS=90
# Local
BACKUP_KEEP_DAYS=30
BACKUP_MIN_KEEP=7
BACKUP_MINIO_KEEP_RUNS=7

# ── Alertas ───────────────────────────────────────────────────────────────────
ALERT_WEBHOOK=

# ── Identificação da chave Fernet usada pela aplicação ────────────────────────
# Só a impressão digital, calculada fora do servidor ou no cofre:
#   printf '%s' "$AILOS_TOKEN_ENCRYPTION_KEY" | sha256sum | cut -c1-16
BACKUP_FERNET_FINGERPRINT=

# ── Cifragem GPG do dump (opcional; o crypt do rclone já cobre o envio) ──────
# BACKUP_ENCRYPT_KEY=backup@mastersat.com.br
# BACKUP_GPG_PUBLIC_KEY_FILE=/backup/chave-publica-backup.asc
